{
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "no-unused-vars": ["error", { "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["scrape.js"],
      "globals": {
        "document": "readonly"
      }
    }
  ]
}
